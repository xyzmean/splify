   <button class="ghost" onclick="fillFromReport()">Взять из отчёта ноды</button>
   <button class="danger" onclick="clearDesired()">Снять задание</button></div>
 </div>
 <div class="card"><h3>Опасное</h3><div class="row"><button class="ghost" onclick="regen('${node}')">Сменить токен</button>
  <button class="danger" onclick="delNode('${node}')">Удалить ноду</button></div></div>`;
 window._rec=rec;
}
function num(v){return v===''||v==null?undefined:v;}
async function publishQuick(iface){const awg={};for(const k of ['jc','jmin','jmax','s1','s2','h1','h2','h3','h4']){const v=$('#f_'+k).value.trim();if(v!=='')awg[k]=v;}
 // Carry the EXISTING peer identity: import replaces peers wholesale, so a peer
 // sent without public_key/allowed_ips would recreate a broken, keyless peer.
 const rec=window._rec||{};const base=(((((rec.last_report||{}).config||{}).wg||{})[iface]||{}).peers||[{}])[0]||{};
 const peer=Object.assign({},base);delete peer.has_preshared_key;delete peer.preshared_key;
 const eh=$('#f_eh').value.trim(),ep=$('#f_ep').value.trim();if(eh)peer.endpoint_host=eh;if(ep)peer.endpoint_port=ep;
 const ifo={};if(Object.keys(awg).length)ifo.awg=awg;if(peer.public_key)ifo.peers=[peer];
 if(!Object.keys(ifo).length)return toast('нет изменений');
 try{const j=await api('PUT','/admin/api/nodes/'+cur+'/desired',{wg:{[iface]:ifo}});toast('опубликовано, gen '+j.generation);openNode(cur);}catch(e){toast('ошибка: '+e.message);} }
async function importConf(){const iface=$('#imp_if').value.trim();const conf=$('#imp_conf').value;if(!conf.trim())return toast('пусто');
 try{const j=await api('POST','/admin/api/nodes/'+cur+'/import-conf',{iface,conf});toast('импорт опубликован, gen '+j.generation);openNode(cur);}catch(e){toast('ошибка: '+e.message);} }
async function publishRaw(){let d;const t=$('#desired').value.trim();if(!t)return clearDesired();try{d=JSON.parse(t);}catch(e){return toast('некорректный JSON');}
 try{const j=await api('PUT','/admin/api/nodes/'+cur+'/desired',d);toast('опубликовано, gen '+j.generation);openNode(cur);}catch(e){toast('ошибка: '+e.message);} }
async function clearDesired(){try{await api('PUT','/admin/api/nodes/'+cur+'/desired',null);toast('задание снято');openNode(cur);}catch(e){toast('ошибка: '+e.message);} }
function fillFromReport(){const r=window._rec.last_report||{};if(!r.config)return toast('отчёта ещё нет');$('#desired').value=JSON.stringify({splify:r.config.splify,wg:r.config.wg},null,2);}
async function regen(node){if(!confirm('Сменить токен ноды? Старый перестанет работать, обнови на роутере.'))return;try{const j=await api('POST','/admin/api/nodes/'+node+'/token/regen');toast('новый токен: '+j.token);openNode(node);}catch(e){toast('ошибка: '+e.message);} }
async function delNode(node){if(!confirm('Удалить ноду '+node+'?'))return;try{await api('DELETE','/admin/api/nodes/'+node);cur=null;$('#detail').innerHTML='<p class="mut">Удалено.</p>';loadNodes();}catch(e){toast('ошибка: '+e.message);} }
async function showConnect(){const j=await api('GET','/admin/api/connect');const s=JSON.stringify(j);try{await navigator.clipboard.writeText(s);toast('JSON подключения скопирован');}catch(e){}
