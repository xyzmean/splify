  <tr><td class="mut">LAN</td><td colspan=3>${esc(summ.lan_iface||'?')} → ${esc(summ.lan_cidr||'?')}</td></tr></table>
  ${eps.length?'<table style="margin-top:8px"><tr><th>Туннель</th><th>Прио</th><th>Live</th><th>Health</th></tr>'+eps.map(e=>`<tr><td>${esc(e.iface)}</td><td>${esc(e.priority)}</td><td>${e.present?'✓':'✗'}</td><td>${esc(e.health||'-')}</td></tr>`).join('')+'</table>':''}
 </div>
 <div class="card"><h3>AmneziaWG: быстрые параметры${prim?' ('+prim+')':''}</h3>
  ${prim?`<div class="row"><div style="flex:2"><label>Endpoint host</label><input id="f_eh" value="${esc(pe.endpoint_host||'')}"></div><div style="flex:1"><label>Port</label><input id="f_ep" value="${esc(pe.endpoint_port||'')}"></div></div>
  <label>Обфускация (Jc/Jmin/Jmax/S1/S2/H1-H4)</label><div class="grid">
