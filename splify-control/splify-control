  <label>Вставьте содержимое .conf</label><textarea id="imp_conf" placeholder="[Interface]\nPrivateKey = ...\n[Peer]\n..."></textarea>
  <div class="row" style="margin-top:8px"><button onclick="importConf()">Импортировать и опубликовать</button></div>
