 for(const n of nodes){const d=document.createElement('div');d.className='node'+(cur===n.node?' sel':'');d.onclick=()=>openNode(n.node);
  d.innerHTML=`<div class="row"><b>${esc(n.node)}</b><span class="sp"></span><span class="pill ${sev(n.overall)}">${esc(n.overall)}</span></div>
   <div class="small mut">${pathLabel(n.state)} · ${esc(n.mode)} · ${ago(n.last_seen)}</div>
   ${n.pending?'<div class="small" style="color:var(--warn)">● ожидает применения (gen '+n.generation+')</div>':''}`;L.appendChild(d);} }
async function openNode(node){cur=node;loadNodes();const rec=await api('GET','/admin/api/nodes/'+node);const rep=rec.last_report||{};const st=rep.status||{};const summ=st.summary||{};const eps=(st.endpoints||[]);
 const wg=(rep.config&&rep.config.wg)||{};const ifaces=Object.keys(wg);const prim=ifaces[0]||'';const pa=(wg[prim]&&wg[prim].awg)||{};const pe=((wg[prim]&&wg[prim].peers)||[{}])[0]||{};
 $('#detail').innerHTML=`
 <h2>${esc(node)} <span class="pill ${sev(st.overall||'?')}">${esc(st.overall||'?')}</span></h2>
 <p class="mut small">Токен ноды: <code>${esc(rec.token)}</code> · generation <b>${esc(rec.generation)}</b> · применено <b>${esc(rep.applied_gen||0)}</b> · ${ago(rec.last_seen)}</p>
