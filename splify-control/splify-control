# ---- bootstrap -------------------------------------------------------------
def serve(handler, host, port, name):
    httpd = ThreadingHTTPServer((host, port), handler)
    if CFG['tls_cert'] and CFG['tls_key']:
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(CFG['tls_cert'], CFG['tls_key'])
        httpd.socket = ctx.wrap_socket(httpd.socket, server_side=True)
    scheme = 'https' if (CFG['tls_cert'] and CFG['tls_key']) else 'http'
    print('[splify-control] %s on %s://%s:%d' % (name, scheme, host, port), flush=True)
    httpd.serve_forever()


def main():
    ap = argparse.ArgumentParser(description='splify control plane (reference)')
    ap.add_argument('--node-host', default='0.0.0.0', help='public node-API bind (routers poll this over WAN)')
    ap.add_argument('--node-port', type=int, default=8080)
    ap.add_argument('--admin-host', default='127.0.0.1', help='admin console bind — set to the WG address (e.g. 10.8.0.1) so it is WG-only')
    ap.add_argument('--admin-port', type=int, default=8088)
    ap.add_argument('--data-dir', default=os.environ.get('SPLIFY_CONTROL_DATA', '/var/lib/splify-control'))
    ap.add_argument('--admin-token', default=os.environ.get('SPLIFY_ADMIN_TOKEN', ''), help='optional bearer token for the admin API (defense in depth on top of the WG-only bind)')
    ap.add_argument('--access-key', default=os.environ.get('SPLIFY_ACCESS_KEY', ''), help='one-time enrollment key routers present to /enroll (auto-generated + persisted if omitted)')
    ap.add_argument('--internal-url', default=os.environ.get('SPLIFY_INTERNAL_URL', ''), help='dashboard URL reachable over the tunnel/WG, e.g. http://10.8.0.1:8080')
    ap.add_argument('--external-url', default=os.environ.get('SPLIFY_EXTERNAL_URL', ''), help='dashboard URL reachable over the public internet, e.g. https://vpn.example.net:8443')
    ap.add_argument('--tls-cert', default='')
    ap.add_argument('--tls-key', default='')
    ap.add_argument('--print-connect', action='store_true', help='print the connection JSON and exit')
    ap.add_argument('--verbose', action='store_true')
    args = ap.parse_args()
    CFG.update(vars(args))
    CFG['data_dir'] = args.data_dir
    os.makedirs(CFG['data_dir'], exist_ok=True)
    CFG['mesh_enabled'] = os.path.exists(mesh_flag_path())

    # Enrollment key: reuse a persisted one so it survives restarts (a router
    # already holds it); otherwise generate, store, and surface it.
    keyfile = os.path.join(CFG['data_dir'], 'access_key')
    if not CFG['access_key']:
        if os.path.exists(keyfile):
            with open(keyfile, encoding='utf-8') as f:
                CFG['access_key'] = f.read().strip()
        else:
            CFG['access_key'] = gen_token()
            with open(keyfile, 'w', encoding='utf-8') as f:
                f.write(CFG['access_key'])
            os.chmod(keyfile, 0o600)

    if args.print_connect:
        print(json.dumps(connect_json(), ensure_ascii=False, indent=2))
        return

    print('[splify-control] connection JSON for routers (paste into LuCI → API → Подключить):', flush=True)
    print(json.dumps(connect_json(), ensure_ascii=False), flush=True)

    t = threading.Thread(target=serve, args=(NodeHandler, args.node_host, args.node_port, 'NODE API'), daemon=True)
    t.start()
    serve(AdminHandler, args.admin_host, args.admin_port, 'ADMIN UI')


if __name__ == '__main__':
    main()
