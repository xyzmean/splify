#!/usr/bin/env python3
# splify-control — reference control plane for splify nodes (routers).
#
# WHY THIS EXISTS: splify routers sit behind carrier-grade NAT with no static IP,
# so nothing can connect IN to them, and the management channel has to keep
# working when their WG tunnel is down. So each router runs an OUTBOUND agent
# (splify-agent) that polls THIS server over the plain internet (WAN). The server
# hands back a "desired" snapshot (full splify config + every wg/awg interface),
# which the router applies — this is how you push a fixed AmneziaWG config to a
# router whose tunnel just died.
#
# TWO listeners, deliberately split:
#   * NODE API  (public)  — POST /poll : routers report status + receive desired
#                           config. Bearer-token per node. Bind 0.0.0.0 so CGNAT
#                           routers reach it over WAN. Put TLS in front of it.
#   * ADMIN UI  (WG-only) — the management console + admin API. Bind it to the WG
#                           address (e.g. 10.8.0.1) so it is reachable ONLY from
#                           inside the WG network, never the public internet.
#
# Generation counter avoids a reboot/poll bounce-loop: the server returns the
# desired snapshot only while the node's reported applied_gen is behind the
# current generation; once the node converges it gets {"noop":true}.
#
# Stdlib only (http.server, json, ssl, hmac) — runs anywhere Python 3.7+ does.
# Storage: one JSON file per node under --data-dir.
#
#   ./splify-control --admin-host 10.8.0.1 --admin-port 8088 \
#                    --node-host 0.0.0.0  --node-port 8080 \
#                    --data-dir /var/lib/splify-control
#
# See README.md for TLS / systemd / firewall guidance.

import argparse
import hmac
import json
import os
import re
import secrets
import ssl
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CFG = {}                       # filled from argparse
LOCK = threading.Lock()        # serialise node-file read/modify/write
NODE_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$')
MAX_BODY = 2 * 1024 * 1024     # 2 MiB cap on any request body


# ---- storage ---------------------------------------------------------------
def node_path(node):
    if not NODE_RE.match(node or ''):
        return None
    return os.path.join(CFG['data_dir'], node + '.json')


def load_node(node):
    p = node_path(node)
    if not p or not os.path.exists(p):
        return None
    try:
        with open(p, 'r', encoding='utf-8') as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save_node(rec):
    p = node_path(rec['node'])
    if not p:
        return
    tmp = p + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(rec, f, ensure_ascii=False, indent=2)
    os.replace(tmp, p)


def list_nodes():
    out = []
    try:
        names = sorted(os.listdir(CFG['data_dir']))
    except OSError:
        names = []
    for fn in names:
        if not fn.endswith('.json'):
            continue
        rec = load_node(fn[:-5])
        if not rec:
            continue
        rep = rec.get('last_report') or {}
        summ = ((rep.get('status') or {}).get('summary')) or {}
        cfg = rep.get('config') or {}
        out.append({
            'node': rec['node'],
            'generation': rec.get('generation', 0),
            'applied_gen': rep.get('applied_gen', 0),
            'has_desired': bool(rec.get('desired')),
            'pending': bool(rec.get('desired')) and rep.get('applied_gen', 0) < rec.get('generation', 0),
            'last_seen': rec.get('last_seen', 0),
            'overall': (rep.get('status') or {}).get('overall', '?'),
            'state': summ.get('state', '?'),
            'mode': summ.get('mode', '?'),
            'lan': cfg.get('lan') or '',
            'sites': cfg.get('sites') or '',
        })
    return out


# ---- helpers ---------------------------------------------------------------
def gen_token():
    return secrets.token_urlsafe(24)


def bearer(headers):
    h = headers.get('Authorization', '')
    if h[:7].lower() == 'bearer ':
        return h[7:].strip()
    return headers.get('X-Splify-Token', '').strip()


def tok_eq(a, b):
    return bool(a) and bool(b) and hmac.compare_digest(str(a), str(b))


# ---- site-to-site mesh -----------------------------------------------------
# Every node reports its LAN subnet (report.config.lan). When the mesh is on, we
# push each node the set of OTHER nodes' LANs as desired.sites — the agent routes
# them over the tunnel (true site-to-site). Recomputed on every poll and toggle;
# a node's generation only bumps when its own set actually changes.
def node_lan(rec):
    cfg = ((rec or {}).get('last_report') or {}).get('config') or {}
    v = cfg.get('lan')
    return v.strip() if isinstance(v, str) else ''


def _node_names():
    try:
        return sorted(n[:-5] for n in os.listdir(CFG['data_dir']) if n.endswith('.json'))
    except OSError:
        return []


def mesh_flag_path():
    return os.path.join(CFG['data_dir'], 'mesh.on')


def set_mesh(enabled):
    CFG['mesh_enabled'] = bool(enabled)
    try:
        if enabled:
            open(mesh_flag_path(), 'w').close()
        elif os.path.exists(mesh_flag_path()):
            os.remove(mesh_flag_path())
    except OSError:
        pass
    recompute_mesh()


def recompute_mesh():
    with LOCK:
        names = _node_names()
        lans = {}
        for n in names:
            r = load_node(n)
            if r:
                lans[n] = node_lan(r)
        on = bool(CFG.get('mesh_enabled'))
        for n in names:
            rec = load_node(n)
            if not rec:
                continue
            mine = lans.get(n, '')
            remotes = (sorted({l for m, l in lans.items() if m != n and l and l != mine})
                       if on else [])
            desired = dict(rec.get('desired') or {})
            cur = sorted(desired['sites']) if isinstance(desired.get('sites'), list) else None
            if cur == remotes:
                continue
            if remotes:
                desired['sites'] = remotes
            elif 'sites' in desired:
                desired['sites'] = []        # push empty once to clear the node
            else:
                continue                     # never meshed; nothing to clear
            rec['desired'] = desired or None
            rec['generation'] = int(rec.get('generation', 0)) + 1
            save_node(rec)


# The "connection JSON" a router imports (LuCI → API → Подключить, or
# `splify-ctl connect`). Carries BOTH reachable URLs + the one-time access_key.
def connect_json():
    return {
        'version': 1,
        'internal': CFG.get('internal_url') or '',
        'external': CFG.get('external_url') or '',
        'access_key': CFG.get('access_key') or '',
    }


# Parse a WireGuard/AmneziaWG .conf into a wg snapshot fragment for one iface.
def parse_conf(text, iface):
    iface_opts, awg, peer = {}, {}, {}
    section = None
    awg_keys = {'jc', 'jmin', 'jmax', 's1', 's2', 's3', 's4',
                'h1', 'h2', 'h3', 'h4', 'i1', 'i2', 'i3', 'i4', 'i5',
                'j1', 'j2', 'j3', 'itime'}
    for raw in text.replace('\r', '').split('\n'):
        line = raw.strip()
        if not line or line[0] in '#;':
            continue
        if line.lower() == '[interface]':
            section = 'i'; continue
        if line.lower() == '[peer]':
            section = 'p'; continue
        if '=' not in line:
            continue
        k, v = line.split('=', 1)
        k = k.strip().lower(); v = v.strip()
        if section == 'i':
            if k == 'privatekey':
                iface_opts['private_key'] = v
            elif k in ('address', 'addresses'):
                iface_opts['addresses'] = [x.strip() for x in v.split(',') if x.strip()]
            elif k == 'dns':
                iface_opts['dns'] = [x.strip() for x in v.split(',') if x.strip()]
            elif k == 'listenport':
                iface_opts['listen_port'] = v
            elif k == 'mtu':
                iface_opts['mtu'] = v
            elif k in awg_keys:
                awg[k] = v
        elif section == 'p':
            if k == 'publickey':
                peer['public_key'] = v
            elif k == 'presharedkey':
                peer['preshared_key'] = v
            elif k == 'allowedips':
                peer['allowed_ips'] = [x.strip() for x in v.split(',') if x.strip()]
            elif k == 'endpoint':
                host, _, port = v.rpartition(':')
                peer['endpoint_host'] = host or v
                if port:
                    peer['endpoint_port'] = port
            elif k == 'persistentkeepalive':
                peer['persistent_keepalive'] = v
    if awg:
        iface_opts['awg'] = awg
    iface_opts['route_allowed_ips'] = '0'
    if peer:
        iface_opts['peers'] = [peer]
    return {'wg': {iface: iface_opts}}


# ---- request handlers ------------------------------------------------------
class Base(BaseHTTPRequestHandler):
    server_version = 'splify-control/1'

    def log_message(self, fmt, *args):
        if CFG['verbose']:
            super().log_message(fmt, *args)

    def _body(self):
        try:
            n = int(self.headers.get('Content-Length', 0))
        except ValueError:
            n = 0
        if n <= 0 or n > MAX_BODY:
            return b''
        return self.rfile.read(n)

    def _json(self, code, obj):
        data = json.dumps(obj, ensure_ascii=False).encode('utf-8')
        self.send_response(code)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.send_header('Content-Length', str(len(data)))
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        self.wfile.write(data)

    def _html(self, code, text):
        data = text.encode('utf-8')
        self.send_response(code)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)


# Public node-facing API: /enroll (access-key gated registration) and /poll.
class NodeHandler(Base):
    def do_POST(self):
        path = self.path.split('?', 1)[0].rstrip('/')
        if path in ('/enroll', '/api/v1/enroll'):
            return self._enroll()
        if path in ('/poll', '/api/v1/poll'):
            return self._poll()
        return self._json(404, {'error': 'not found'})

    # Register a node's SELF-GENERATED token, authenticated by the one-time
    # access_key from the connection JSON. This is the ONLY way a node enters the
    # fleet — /poll never auto-registers (the listener is public).
    def _enroll(self):
        if not CFG['access_key']:
            return self._json(503, {'error': 'enrollment disabled (no access_key configured)'})
        if not tok_eq(bearer(self.headers), CFG['access_key']):
            return self._json(401, {'error': 'bad access_key'})
        try:
            body = json.loads(self._body() or b'{}')
        except ValueError:
            return self._json(400, {'error': 'bad json'})
        node = str(body.get('node_id') or '').strip()
        token = str(body.get('node_token') or '').strip()
        if not NODE_RE.match(node):
            return self._json(400, {'error': 'bad node id'})
        if not token:
            return self._json(400, {'error': 'missing node_token'})
        with LOCK:
            rec = load_node(node) or {'node': node, 'generation': 0, 'desired': None,
                                      'last_report': None, 'last_seen': 0, 'history': []}
            rec['token'] = token            # node owns its key; we just record it
            rec['hostname'] = body.get('hostname', '')
            rec['enrolled_at'] = int(time.time())
            save_node(rec)
        return self._json(200, {'ok': True, 'node_id': node})

    def _poll(self):
        try:
            report = json.loads(self._body() or b'{}')
        except ValueError:
            return self._json(400, {'error': 'bad json'})
        node = str(report.get('node') or self.headers.get('X-Splify-Node') or '').strip()
        token = bearer(self.headers)
        if not NODE_RE.match(node):
            return self._json(400, {'error': 'bad node id'})
        with LOCK:
            rec = load_node(node)
            if rec is None:
                return self._json(403, {'error': 'not enrolled'})
            if not tok_eq(token, rec.get('token')):
                return self._json(401, {'error': 'bad token'})
            rec['last_seen'] = int(time.time())
            rec['last_report'] = report
            st = (report.get('status') or {})
            summ = st.get('summary') or {}
            hist = rec.get('history') or []
            hist.append({'ts': rec['last_seen'], 'overall': st.get('overall', '?'),
                         'state': summ.get('state', '?')})
            rec['history'] = hist[-200:]
            applied = int(report.get('applied_gen', 0) or 0)
            save_node(rec)
        # Propagate this node's freshly-reported LAN into the mesh, then re-read
        # so a newly-computed sites push reaches the node on this same poll.
        recompute_mesh()
        with LOCK:
            rec = load_node(node) or {}
            generation = int(rec.get('generation', 0))
            desired = rec.get('desired')
        if desired and applied < generation:
            resp = dict(desired)
            resp['generation'] = generation
            return self._json(200, resp)
        return self._json(200, {'noop': True, 'generation': generation})

    def do_GET(self):
        # a tiny health probe so you can curl the public endpoint
        if self.path.split('?', 1)[0].rstrip('/') in ('/health', '/api/v1/health'):
            return self._json(200, {'ok': True})
        return self._json(404, {'error': 'not found'})


# Admin console + admin API. Bind to the WG address so it is WG-only.
class AdminHandler(Base):
    def _auth_ok(self):
        if not CFG['admin_token']:
            return True
        return tok_eq(bearer(self.headers), CFG['admin_token'])

    def do_GET(self):
        if not self._auth_ok():
            return self._json(401, {'error': 'admin auth required'})
        path = self.path.split('?', 1)[0]
        if path == '/' or path == '/index.html':
            return self._html(200, ADMIN_HTML)
        if path == '/admin/api/nodes':
            return self._json(200, {'nodes': list_nodes()})
        if path == '/admin/api/connect':
            return self._json(200, connect_json())
        if path == '/admin/api/mesh':
            rows = []
            for n in _node_names():
                rec = load_node(n)
                if not rec:
                    continue
                desired = rec.get('desired') or {}
                rows.append({
                    'node': n,
                    'lan': node_lan(rec),
                    'want': desired.get('sites') if isinstance(desired.get('sites'), list) else [],
                    'applied': ((rec.get('last_report') or {}).get('config') or {}).get('sites') or '',
                    'pending': bool(rec.get('desired')) and
                               int((rec.get('last_report') or {}).get('applied_gen', 0) or 0) < int(rec.get('generation', 0)),
                })
            return self._json(200, {'enabled': bool(CFG.get('mesh_enabled')), 'nodes': rows})
        m = re.match(r'^/admin/api/nodes/([^/]+)$', path)
        if m:
            rec = load_node(m.group(1))
            if not rec:
                return self._json(404, {'error': 'no such node'})
            return self._json(200, rec)
        return self._json(404, {'error': 'not found'})

    def do_POST(self):
        if not self._auth_ok():
            return self._json(401, {'error': 'admin auth required'})
        path = self.path.split('?', 1)[0]
        if path == '/admin/api/mesh':
            try:
                body = json.loads(self._body() or b'{}')
            except ValueError:
                return self._json(400, {'error': 'bad json'})
            set_mesh(bool(body.get('enabled')))
            return self._json(200, {'ok': True, 'enabled': bool(CFG.get('mesh_enabled'))})
        m = re.match(r'^/admin/api/nodes/([^/]+)/import-conf$', path)
        if m:
            node = m.group(1)
            try:
                payload = json.loads(self._body() or b'{}')
            except ValueError:
                return self._json(400, {'error': 'bad json'})
            iface = (payload.get('iface') or '').strip()
            conf = payload.get('conf') or ''
            if not NODE_RE.match(iface or ''):
                return self._json(400, {'error': 'bad iface'})
            snap = parse_conf(conf, iface)
            return self._set_desired(node, snap)
        m = re.match(r'^/admin/api/nodes/([^/]+)/token/regen$', path)
        if m:
            with LOCK:
                rec = load_node(m.group(1))
                if not rec:
                    return self._json(404, {'error': 'no such node'})
                rec['token'] = gen_token()
                save_node(rec)
            return self._json(200, {'token': rec['token']})
        return self._json(404, {'error': 'not found'})

    def do_PUT(self):
        if not self._auth_ok():
            return self._json(401, {'error': 'admin auth required'})
        m = re.match(r'^/admin/api/nodes/([^/]+)/desired$', self.path.split('?', 1)[0])
        if m:
            try:
                desired = json.loads(self._body() or b'null')
            except ValueError:
                return self._json(400, {'error': 'bad json'})
            return self._set_desired(m.group(1), desired)
        return self._json(404, {'error': 'not found'})

    def do_DELETE(self):
        if not self._auth_ok():
            return self._json(401, {'error': 'admin auth required'})
        m = re.match(r'^/admin/api/nodes/([^/]+)$', self.path.split('?', 1)[0])
        if m:
            p = node_path(m.group(1))
            if p and os.path.exists(p):
                os.remove(p)
                return self._json(200, {'ok': True})
            return self._json(404, {'error': 'no such node'})
        return self._json(404, {'error': 'not found'})

    def _set_desired(self, node, desired):
        with LOCK:
            rec = load_node(node)
            if rec is None:
                # allow pre-creating a node from the console (operator sets token
                # later via regen, or the node self-registers on first poll)
                rec = {'node': node, 'token': gen_token(), 'generation': 0,
                       'desired': None, 'last_report': None, 'last_seen': 0,
                       'history': []}
            # a desired of null/empty clears the pending push
            if desired in (None, {}, ''):
                rec['desired'] = None
            else:
                rec['desired'] = desired
                rec['generation'] = int(rec.get('generation', 0)) + 1
            save_node(rec)
        return self._json(200, {'ok': True, 'generation': rec['generation'],
                                'token': rec['token']})


