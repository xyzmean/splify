#!/bin/sh /etc/rc.common
# procd service for splify's sing-box (VLESS/Hysteria2) endpoints: one named
# procd instance per configured `config singbox` section that is ALSO
# referenced by a `config endpoint` (type 'singbox') failover entry — an
# orphaned/unused `config singbox` section (nobody's failover list points at
# it) never gets a process started for it.
#
# Self-gates on the sing-box package actually being installed (soft/runtime-
# detected dependency, same convention as zapret) — installing splify alone
# never requires sing-box; the endpoint simply reports "down" (see common.sh's
# _ep_singbox_down) until the operator opts in with `opkg install sing-box`.
START=94
STOP=11
USE_PROCD=1

# One `config singbox` section -> one named procd instance, but only if it's
# actually referenced by a `config endpoint` (failover candidate) — an
# orphaned/unused singbox section starts nothing. Top-level (not nested inside
# start_service) so shellcheck's reachability analysis can see it's invoked via
# config_foreach, same convention as common.sh's own config_foreach callbacks.
_singbox_start_one() {
    local iface
    config_get iface "$1" iface ''
    [ -n "$iface" ] || return 0
    is_endpoint "$iface" || return 0   # not referenced by any failover endpoint — skip

    /usr/local/sbin/splify-singbox-render "$iface" || {
        log "singbox $iface: render failed, instance not started"
        return 0
    }

    procd_open_instance "$iface"
    procd_set_param command sing-box run -c "$(singbox_conf_file "$iface")"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

start_service() {
    . /lib/functions.sh
    # shellcheck source=/dev/null
    . /usr/local/lib/splify/common.sh

    command -v sing-box >/dev/null 2>&1 || {
        log "sing-box not installed — no singbox endpoints started"
        return 0
    }

    config_load splify
    config_foreach _singbox_start_one singbox
}

service_triggers() {
    procd_add_reload_trigger "splify"
}
