#!/bin/sh
# splify 2.0.0 config migration — PURELY ADDITIVE and idempotent.
#
# OpenWrt's /etc/init.d/boot runs every /etc/uci-defaults/* script once on the
# first boot after install/upgrade, then deletes it if it exits 0. 1.7.x configs
# keep working untouched; this only fills in new 2.0.0 defaults so the new code
# always has a value to read (no schema renames/removals — see design §2.1).

# Nothing to migrate if splify was never configured (fresh install ships its
# own /etc/config/splify with the new defaults already).
[ -n "$(uci -q get splify.global)" ] || exit 0

changed=0

# Tag every endpoint with an explicit transport `type` (default wg, covering
# wireguard+amneziawg). The transport-agnostic dispatch (design §2.2) switches on
# this, and a future sing-box (vless/hysteria) backend will be selected per
# endpoint by setting type=singbox.
i=0
while [ -n "$(uci -q get "splify.@endpoint[$i]" 2>/dev/null)" ]; do
    if [ -z "$(uci -q get "splify.@endpoint[$i].type" 2>/dev/null)" ]; then
        uci set "splify.@endpoint[$i].type=wg"
        changed=1
    fi
    i=$((i + 1))
done

# Remote management API (2.x): ensure the section exists and seed a strong token
# + a stable node_id on first boot. Both stay closed (enabled=0) until opted in;
# we only need the secrets ready so enabling is a one-click action, never a
# "generate a token by hand" chore. Purely additive — never overwrites a value
# an operator already set.
[ -n "$(uci -q get splify.api)" ] || { uci set splify.api=api; changed=1; }
if [ -z "$(uci -q get splify.api.token)" ]; then
    if [ -r /dev/urandom ]; then
        tok="$(head -c 24 /dev/urandom | base64 2>/dev/null | tr '+/' '-_' | tr -d '=\n')"
    fi
    [ -n "$tok" ] || tok="$(printf '%s%s' "$(date +%s%N)" "$$" | md5sum | cut -c1-32)"
    uci set "splify.api.token=$tok"; changed=1
fi
if [ -z "$(uci -q get splify.api.node_id)" ]; then
    host="$(uci -q get system.@system[0].hostname 2>/dev/null || cat /proc/sys/kernel/hostname 2>/dev/null || echo splify)"
    rnd="$(head -c 4 /dev/urandom 2>/dev/null | hexdump -e '4/1 "%02x"' 2>/dev/null)"
    [ -n "$rnd" ] || rnd="$(date +%s | tail -c 6)"
    uci set "splify.api.node_id=${host}-${rnd}"; changed=1
fi

[ "$changed" = 1 ] && uci commit splify
exit 0
