#!/bin/sh
# splify-sync-nozapret — rebuild zapret's nozapret bypass set from:
#   ZAPRET_PRIVATES + RU file [+ IPSUM/VPN file]
#
# nozapret = IPs zapret must NOT touch. The VPN (ipsum) IPs are included while a
# tunnel is up (they're tunneled, so zapret should leave them alone). On full
# tunnel failure, splify-failover calls us with NOZAPRET_INCLUDE_VPN=0 so those
# IPs DROP OUT of nozapret and zapret DPI-bypasses them on WAN egress.
#
# Memory-safe: emits one compact `add element { x,y,z }` block, NOT per-line
# `add element { x }` (which on 240MB routers OOMs at ~38k+ entries).

set -e   # fail-fast on curl/validation; no `-u`, /lib/functions.sh isn't nounset-safe
. /usr/local/lib/splify/common.sh

# The nozapret set is rebuilt on EVERY failover tick (set_vpn -> rebuild_nozapret).
# When inputs haven't changed and the live set is healthy, that rebuild + its log
# line is pure churn (N1 log-flood / N2 CPU). nozapret_current decides "already
# current?": same signature AND live set >= min floor AND not force-requested.
# Pure logic (no nft/uci) so it is unit-tested off-box via tests/helper.bash.
nozapret_current() {   # NEW_SIG OLD_SIG LIVE_COUNT MIN FORCED
    [ "$5" = 1 ] && return 1                         # forced -> rebuild
    [ -n "$1" ] && [ "$1" = "$2" ] || return 1       # sig empty/changed -> rebuild
    [ "${3:-0}" -ge "${4:-0}" ] 2>/dev/null || return 1  # live set drained -> rebuild
    return 0
}

[ "$ZAPRET_ENABLED" = "1" ] || { log "zapret disabled (ZAPRET_ENABLED=0)"; exit 0; }
# An explicit caller (failover) sets NOZAPRET_INCLUDE_VPN. When unset (daily cron
# / ipsum-ru refresh cascade), derive it from the live state so a refresh while in
# the zapret/wan fallback doesn't re-add the VPN prefixes and silently disable the
# WAN DPI-bypass until the next failover tick.
if [ -n "${NOZAPRET_INCLUDE_VPN:-}" ]; then
    INCLUDE_VPN="$NOZAPRET_INCLUDE_VPN"
else
    case "$(read_state)" in
        zapret|wan) INCLUDE_VPN=0 ;;
        *)          INCLUDE_VPN=1 ;;
    esac
fi

TMP="/tmp/splify-sync-nozapret.$$"
NOZAPRET_SIG="/var/run/splify-nozapret.sig"
# The list actually loaded into the set, kept on tmpfs (not flash: it is derived
# from ru/ipsum on every run, and rewriting ~700KB of overlay per sync is wear
# for nothing). nft_load_set reads it chunk by chunk, and a partial load needs it
# to still be there when the next tick retries.
NOZAPRET_LIST="/var/run/splify-nozapret.lst"
mkdir -p "$TMP"
trap 'rm -rf "$TMP"' EXIT INT TERM

# Built in two tiers, because the destination set has a HARD CAPACITY (zapret
# declares nozapret with `size 65536`) and ru+ipsum together now exceed it:
#
#   must  = private ranges + the ru/cn list. These are the reason the bypass
#           exists: RU traffic has to stay direct and unmangled.
#   extra = the VPN (ipsum) prefixes, included only while a tunnel is up. They
#           matter least: that traffic is inside the tunnel, so what zapret does
#           to a plain-WAN packet toward those addresses is moot until the
#           fallback state — and in the fallback state INCLUDE_VPN is 0 and they
#           are meant to drop out anyway.
#
# If everything fits, nothing is dropped and behaviour is exactly as before.
{
    for p in $ZAPRET_PRIVATES; do echo "$p"; done
    [ -r "$RU_FILE" ] && cat "$RU_FILE" || true
} | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?$' \
  | sort -u > "$TMP/must.lst"
# The tiers may overlap; the final `sort -u` below dedups. (No `comm` here — it is
# absent from this busybox, and subtracting the tiers up front would only make the
# room arithmetic marginally tighter.)
: > "$TMP/extra.lst"
if [ "$INCLUDE_VPN" = "1" ] && [ -r "$IPSUM_FILE" ]; then
    grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?$' "$IPSUM_FILE" \
        | sort -u > "$TMP/extra.lst"
fi

# Fit to the destination set — AGGREGATION FIRST, dropping entries only if merging
# is not enough. The union is largely runs of adjacent prefixes: on the test box
# 74 648 raw entries merged losslessly to well under the 65 536 capacity, so what
# used to be "the load fails and the bypass runs on an empty set" now needs no
# truncation at all.
CAPACITY="$(nft_set_capacity "$ZAPRET_NOZAPRET_TABLE" "$ZAPRET_NOZAPRET_SET")"
cat "$TMP/must.lst" "$TMP/extra.lst" | sort -u > "$TMP/raw.lst"
# Deliberately shallow ladder: an address wrongly inside nozapret is an address
# zapret will NOT DPI-bypass, so a blocked site in a widened gap stops working on
# the WAN path. Better to drop the whole ipsum tier (below) than to widen further —
# with an unbounded ladder a 16MB box reached +225M addresses.
FIT_SLACK_LADDER="0 64 256"
export FIT_SLACK_LADDER
if fit_list_for_set "$ZAPRET_NOZAPRET_SET" "$TMP/raw.lst" "$TMP/all.lst" "$CAPACITY"; then
    :
else
    # Even the widest aggregation does not fit. Now drop, and drop the right tier:
    # the VPN (ipsum) prefixes, keeping privates + ru/cn intact.
    _must_n="$(wc -l < "$TMP/must.lst")"
    _extra_n="$(wc -l < "$TMP/extra.lst")"
    warn_throttled nozapret-cap 3600 \
        "nozapret: $(( _must_n + _extra_n )) entries do not fit this router even aggregated — dropping the $_extra_n VPN prefixes, keeping privates+ru/cn"
    if ! fit_list_for_set "$ZAPRET_NOZAPRET_SET" "$TMP/must.lst" "$TMP/all.lst" "$CAPACITY"; then
        # Not even ru/cn alone fits: keep the head of it rather than nothing, so
        # the most of the bypass that can work does.
        warn "nozapret: ru/cn alone ($_must_n) does not fit either — truncating; RU traffic beyond the cut may be DPI-mangled"
        head -n 20000 "$TMP/must.lst" > "$TMP/all.lst"
    fi
fi

count=$(wc -l < "$TMP/all.lst")
# The min-count floor guards the NORMAL set against a botched list refresh. In
# degradation mode (INCLUDE_VPN=0) we are deliberately shrinking the set to evict
# the VPN/ipsum prefixes so zapret DPI-bypasses them on WAN — aborting here would
# leave the previous (ipsum-laden) set in place and defeat the fallback, so the
# floor is enforced only when the VPN set is included.
if [ "$INCLUDE_VPN" = "1" ] && [ "$count" -lt "$ZAPRET_NOZAPRET_MIN" ]; then
    die "too few entries: $count (need $ZAPRET_NOZAPRET_MIN)"
fi

# N1/N2: skip the rebuild + log entirely when the candidate set is byte-identical
# to the last synced one AND the live set is still healthy. INCLUDE_VPN is part of
# the signature so the degradation toggle (1->0) always forces a rebuild.
NEW_SIG="$INCLUDE_VPN:$(md5sum < "$TMP/all.lst" | cut -d' ' -f1)"
# `|| true` is load-bearing: the sig lives on tmpfs, so after a reboot the file
# is GONE, the bare `cat` exits 1 and `set -e` would kill the script right here
# — before the rebuild — leaving nozapret with only zapret's own private nets
# (and the sig is written last, so every subsequent tick died the same way).
OLD_SIG="$(cat "$NOZAPRET_SIG" 2>/dev/null || true)"
# "Is the live set still healthy?" used to be answered by COUNTING it —
# `nft list set` on this set (44k entries in practice) expands every interval
# into text and cost 54-65MB of RSS, which is precisely the allocation the
# OOM-killer kept shooting on a 240MB router, right before this script then
# reloaded the same set with a second such allocation. nozapret_current() only
# compares the count against the floor, so a probe answers the same question:
# healthy → report the floor, drained/partial → report 0. Same decision, O(1)
# lookups instead of a full dump. (The pure decision function keeps its exact
# signature and its unit tests.)
if set_healthy "$ZAPRET_NOZAPRET_TABLE" "$ZAPRET_NOZAPRET_SET" "$TMP/all.lst"; then
    LIVE="$ZAPRET_NOZAPRET_MIN"
else
    LIVE=0
fi
if nozapret_current "$NEW_SIG" "$OLD_SIG" "${LIVE:-0}" "$ZAPRET_NOZAPRET_MIN" "${SPLIFY_FORCE_SYNC:-0}"; then
    exit 0
fi

# The candidate list has to outlive $TMP's EXIT trap: nft_load_set reads it, and
# on a partial load the next tick needs to see the same bytes to retry.
cat "$TMP/all.lst" > "$NOZAPRET_LIST"
nft_load_set "$ZAPRET_NOZAPRET_TABLE" "$ZAPRET_NOZAPRET_SET" "$NOZAPRET_LIST"
case $? in
    0) : ;;
    # 2 = does not fit in this router's memory. nft_load_set has already said so
    # (throttled) and splify-doctor reports it; the PREVIOUS set contents are
    # untouched, so the bypass keeps working with what it had. Exiting non-zero
    # here would only add an ERROR line to the log on every failover tick.
    2) exit 0 ;;
    *) die "nft sync failed (list kept at $NOZAPRET_LIST; the next tick retries)" ;;
esac
printf '%s\n' "$NEW_SIG" > "$NOZAPRET_SIG"
log "nozapret synced: $count entries"
