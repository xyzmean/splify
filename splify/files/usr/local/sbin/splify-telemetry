#!/bin/sh
# splify-telemetry — gathers debug information and sends it to the dashboard.
# Runs only if telemetry=1 is configured (chosen during easyinstall or set in
# config), OR auto-enabled for a Cloudflare WARP node set up WITHOUT easyinstall
# (where no one was prompted to opt in). See _maybe_autosubscribe() below.
. /usr/share/libubox/jshn.sh
. /usr/local/lib/splify/common.sh 2>/dev/null || true

# Cloudflare's IPv4 ranges (mirrors lists/cloudflare.lst in
# xyzmean/ru-bypass-ipsets). WARP's UDP endpoint is anycast across these, so an
# endpoint pinned to a literal CF IP here is a WARP node. engage.cloudflareclient
# .com is the stable anycast hostname and is matched as a literal too.
CF_NETS="1.0.0.0/24 1.1.1.0/24 35.200.0.0/14 103.21.244.0/22 103.22.200.0/22 \
103.31.4.0/22 104.16.0.0/13 104.24.0.0/14 108.162.192.0/18 131.0.72.0/22 \
141.101.64.0/18 162.158.0.0/15 172.64.0.0/13 173.245.48.0/20 188.114.96.0/20 \
190.93.240.0/20 197.234.240.0/22 198.41.128.0/17"

# Is $1 a Cloudflare IPv4? busybox awk provides and()/compl()/rshift()
# (verified on the OpenWrt toolchain), so the prefix-mask math is one awk pass
# and needs no extra tools. Non-IPv4 input returns false.
_ip_in_cf() {
    case "$1" in
        *[!0-9.]*|"") return 1 ;;   # not a dotted-quad literal
    esac
    awk -v ip="$1" -v nets="$CF_NETS" '
        function i2n(s,   a) { split(s,a,"."); return (a[1]*16777216)+(a[2]*65536)+(a[3]*256)+a[4] }
        BEGIN {
            if (split(ip, p, ".") != 4) exit 1
            for (i = 1; i <= 4; i++) if (p[i] !~ /^[0-9]+$/ || p[i] > 255) exit 1
            pip = i2n(ip)
            m = split(nets, c, " ")
            for (i = 1; i <= m; i++) {
                split(c[i], e, "/"); pl = e[2] + 0
                mask = and(compl(rshift(0xffffffff, pl)), 0xffffffff)
                if (and(pip, mask) == and(i2n(e[1]), mask)) exit 0
            }
            exit 1
        }
    ' 2>/dev/null
}

# Find the WARP interface name (e.g. warp0, wp0, wg0). Returns the name of the
# first AmneziaWG/WireGuard interface pointing to a CF endpoint.
_get_warp_iface() {
    local out
    out=$(uci -q show network 2>/dev/null | awk -F'=' '
        /\.endpoint_host=/ {
            key = $1
            host = $2
            gsub(/'\''/, "", host)
            print key " " host
        }
    ')
    
    echo "$out" | while read -r key host; do
        [ -z "$key" ] && continue
        local is_cf=0
        if [ "$host" = "engage.cloudflareclient.com" ]; then
            is_cf=1
        elif _ip_in_cf "$host"; then
            is_cf=1
        fi
        
        if [ "$is_cf" -eq 1 ]; then
            local ifname=""
            if echo "$key" | grep -q 'amneziawg_'; then
                ifname=$(echo "$key" | sed -n "s/.*@amneziawg_\([^\[]*\).*/\1/p")
            elif echo "$key" | grep -q 'wireguard_'; then
                ifname=$(echo "$key" | sed -n "s/.*@wireguard_\([^\[]*\).*/\1/p")
            else
                ifname=$(echo "$key" | cut -d"." -f2)
            fi
            
            if [ -n "$ifname" ]; then
                echo "$ifname"
                return 0
            fi
        fi
    done
    return 1
}

WARP_IFACE="$(_get_warp_iface)"

# Auto-subscribe a Cloudflare WARP node that was NOT installed via easyinstall.
# easyinstall always writes splify.global.telemetry (0 or 1, from the prompt), so
# an UNSET option is a reliable "no one opted in or out" marker. When that is the
# case AND warp0 points at Cloudflare WARP, opt telemetry in by default so these
# auto-created tunnels can be debugged. Idempotent: once set (by us, easyinstall
# or a user) it never flips again. Safe to run on every cron tick.
_maybe_autosubscribe() {
    [ -z "$(uci -q get splify.global.telemetry)" ] || return 0
    [ -n "$WARP_IFACE" ] || return 0
    uci -q set splify.global.telemetry='1'
    uci -q commit splify
    logger -t splify "telemetry auto-enabled (Cloudflare WARP detected, non-easyinstall)"
}

# Only run if telemetry=1 is configured (or just auto-enabled above).
_telemetry="$(uci -q get splify.global.telemetry)"
if [ "$_telemetry" != "1" ]; then
    _maybe_autosubscribe
    _telemetry="$(uci -q get splify.global.telemetry)"
    [ "$_telemetry" = "1" ] || exit 0
fi

# Only collect when a WARP interface exists (telemetry is WARP-tunnel specific).
[ -n "$WARP_IFACE" ] || exit 0

URL="https://snissfxxada21.vercel.app/api/poll" # Assuming deployed to Vercel, or we could just use a placeholder if we don't know the exact domain. But since it's an API, maybe we send it to snissfxxada21.vercel.app. Or we can ask for the exact domain. For now we will use a placeholder or read it from config.
# Actually, the user says "дашборду git@github.com:xyzmean/snissfxxada21.git"
# I will make it configurable or hardcode a sensible default, maybe the vercel domain based on the repo name: "https://snissfxxada21.vercel.app/api/poll"
# Or let's use a variable.
TELEMETRY_URL="$(uci -q get splify.global.telemetry_url)"
[ -n "$TELEMETRY_URL" ] || TELEMETRY_URL="https://snissfxxada21.vercel.app/api/poll"

# 1. IP of warp endpoint
WARP_EP="$(uci -q get network.$WARP_IFACE.endpoint_host)"

# 2. Lists used
IPSUM_URL="$(uci -q get splify.global.ipsum_url)"
RU_URL="$(uci -q get splify.global.ru_url)"

# 3. Failures and causes
FAILCOUNT=$(cat /var/run/splify-failcount 2>/dev/null || echo "0")
LAST_EVENTS=$(tail -n 10 /var/run/splify-events 2>/dev/null || echo "No events")

# 4. Traffic amount
RX_BYTES=$(cat /sys/class/net/$WARP_IFACE/statistics/rx_bytes 2>/dev/null || echo "0")
TX_BYTES=$(cat /sys/class/net/$WARP_IFACE/statistics/tx_bytes 2>/dev/null || echo "0")

# 5. AWG parameters
AWG_JC="$(uci -q get network.$WARP_IFACE.jc)"
AWG_JMIN="$(uci -q get network.$WARP_IFACE.jmin)"
AWG_JMAX="$(uci -q get network.$WARP_IFACE.jmax)"
AWG_S1="$(uci -q get network.$WARP_IFACE.s1)"
AWG_S2="$(uci -q get network.$WARP_IFACE.s2)"
AWG_H1="$(uci -q get network.$WARP_IFACE.h1)"
AWG_H2="$(uci -q get network.$WARP_IFACE.h2)"
AWG_H3="$(uci -q get network.$WARP_IFACE.h3)"
AWG_H4="$(uci -q get network.$WARP_IFACE.h4)"

# 6. Zapret parameters (if installed)
ZAPRET_MODE="$(uci -q get splify.global.zapret_enabled)"

# 7. Router info
ROUTER_MODEL="$(cat /tmp/sysinfo/model 2>/dev/null || echo "unknown")"
ROUTER_BOARD="$(cat /tmp/sysinfo/board_name 2>/dev/null || echo "unknown")"
UPTIME="$(awk '{print $1}' /proc/uptime)"
SPLIFY_VERSION="$(opkg status splify 2>/dev/null | grep Version | awk '{print $2}')"
[ -z "$SPLIFY_VERSION" ] && SPLIFY_VERSION="$(apk info -e splify -v 2>/dev/null | sed 's/^splify-//')"
OPENWRT_VERSION="$(cat /etc/openwrt_release 2>/dev/null | grep DISTRIB_RELEASE | cut -d"'" -f2)"
LOAD_AVG="$(cat /proc/loadavg 2>/dev/null | awk '{print $1}')"
PING_MS="$(ping -I "$WARP_IFACE" -c 1 -W 1 1.1.1.1 2>/dev/null | awk -F'/' '/round-trip/ || /rtt/ {print $4; exit}')"
MTU="$(cat /sys/class/net/$WARP_IFACE/mtu 2>/dev/null || echo "unknown")"

# Build JSON
json_init
json_add_string "warp_ep" "$WARP_EP"
json_add_string "ipsum_url" "$IPSUM_URL"
json_add_string "ru_url" "$RU_URL"
json_add_string "fail_count" "$FAILCOUNT"
json_add_string "last_events" "$LAST_EVENTS"
json_add_string "rx_bytes" "$RX_BYTES"
json_add_string "tx_bytes" "$TX_BYTES"
json_add_object "awg_params"
json_add_string "jc" "$AWG_JC"
json_add_string "jmin" "$AWG_JMIN"
json_add_string "jmax" "$AWG_JMAX"
json_add_string "s1" "$AWG_S1"
json_add_string "s2" "$AWG_S2"
json_add_string "h1" "$AWG_H1"
json_add_string "h2" "$AWG_H2"
json_add_string "h3" "$AWG_H3"
json_add_string "h4" "$AWG_H4"
json_close_object
json_add_string "zapret_mode" "$ZAPRET_MODE"
json_add_string "router_model" "$ROUTER_MODEL"
json_add_string "router_board" "$ROUTER_BOARD"
json_add_string "uptime" "$UPTIME"
json_add_string "splify_version" "$SPLIFY_VERSION"
json_add_string "openwrt_version" "$OPENWRT_VERSION"
json_add_string "load_avg" "$LOAD_AVG"
json_add_string "ping_ms" "$PING_MS"
json_add_string "mtu" "$MTU"
json_close_object

# Send via curl
curl -s -X POST \
  -H "Content-Type: application/json" \
  -H "X-Splify-Node: $ROUTER_BOARD" \
  -d "$(json_dump)" \
  "$TELEMETRY_URL" > /dev/null

exit 0
