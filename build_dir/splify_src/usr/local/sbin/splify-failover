#!/bin/sh
# splify-failover — multi-interface priority failover + health/route manager.
#
# Replaces the old single-tunnel watchdog. Endpoints are existing awg/wg
# interfaces listed in UCI (`config endpoint`, lowest priority number wins).
#
# Each tick walks the endpoints best-first and picks the first HEALTHY one,
# probing candidates without touching the live path (`ping -I <iface>` through a
# parallel iface — the iface carrying traffic is never torn down to test others):
#   1. current iface healthy            -> keep it
#   2. current iface stuck              -> RESTART it first (ifdown/ifup), recheck
#   3. a higher-priority iface healthy  -> switch up to it (recover toward #1)
#   4. some lower-priority iface healthy -> fail over down to it
#      (a candidate that is present-but-unhealthy is also re-setup via
#      ifdown/ifup: it carries no traffic, and a plain `ifup` is a netifd NO-OP
#      on an up interface, so it can never heal a stuck tunnel — see
#      probe_candidate)
#   5. no tunnel healthy + zapret avail -> WAN fallback, pull VPN IPs OUT of
#      nozapret so zapret DPI-bypasses them on WAN (state "zapret")
#   6. no tunnel + no/failing zapret     -> plain WAN fallback (state "wan")
#      (killswitch=1 instead blackholes table 200 so policy traffic never leaks)
#
#   splify-failover            one pass (also called by splify-apply)
#   splify-failover --daemon   apply once, then loop every UCI `interval`
# No `set -u`: OpenWrt's config_* helpers (sourced below) aren't nounset-safe.
. /usr/local/lib/splify/common.sh

# ---- health probing --------------------------------------------------------
# iface_present / zapret_running / zapret_available / health_ping live in common.sh.

# WAN reachability (default route / no iface bind) — for zapret vs wan rung.
wan_healthy() {
    curl --max-time "$HEALTH_CURL_TIMEOUT" -fsS -o /dev/null "$HEALTH_CURL_URL" >/dev/null 2>&1
}

# wait for an endpoint to report liveness (wg = handshake age via ep_liveness).
wait_handshake() {
    _i=0
    while [ "$_i" -lt "$HS_WAIT" ]; do
        [ "$(ep_liveness "$1")" -lt 150 ] 2>/dev/null && return 0
        sleep 1; _i=$((_i + 1))
    done
    return 1
}

iface_healthy() {
    ep_present "$1" || return 1
    # health_ping is authoritative AND wakes an idle tunnel (its first packet
    # triggers a handshake), so don't pre-reject on a stale handshake age — a
    # keepalive-less idle peer would otherwise look dead though it still works.
    health_ping "$1"
}

restart_iface() {   # WG often unsticks on a plain restart — do this FIRST
    log "restarting stuck iface $1"
    journal restart "$1" "$1" "stuck endpoint restarted"
    ep_restart "$1"
    wait_handshake "$1"
}

bring_up() {        # bring a candidate up in parallel (no list/route changes yet)
    ep_bringup "$1"
    wait_handshake "$1"
}

# Probe a NON-active candidate; 0 iff it ends up healthy. The crucial rung is
# "present but unhealthy": `ifup` is a netifd NO-OP on an already-up interface,
# so after a degrade (state wan/zapret/killswitch, _cur empty) nothing would
# ever re-setup a wedged tunnel — the daemon then sits in fallback forever even
# after the WG server recovers, and only a manual ifdown/ifup (what a dashboard
# config re-push does) revives it. Failure modes that ONLY a full re-setup
# heals: a stale resolved endpoint IP (netifd resolves the hostname once, at
# proto setup — a DDNS move is never picked up), a wedged UDP/CGNAT path (the
# re-setup rebinds the socket), a netifd proto-error state. The bounce is
# non-disruptive: a candidate reaching this rung carries no traffic (routes
# point at _cur / blackhole / WAN). Log-only, no journal: a long-dead candidate
# would flood the events ring with a restart entry every tick.
probe_candidate() {
    if ! ep_present "$1"; then
        bring_up "$1"
    elif iface_healthy "$1"; then
        return 0
    else
        log "candidate $1 present but unhealthy — re-setup (ifdown/ifup)"
        ep_restart "$1"
        wait_handshake "$1"
    fi
    iface_healthy "$1"
}

# ---- zapret -----------------------------------------------------------------
ensure_zapret_running() {
    [ "$ZAPRET_ENABLED" = "1" ] || return 0
    [ -x "$ZAPRET_INIT" ] || return 0
    "$ZAPRET_INIT" enabled >/dev/null 2>&1 || "$ZAPRET_INIT" enable >/dev/null 2>&1 || true
    zapret_running || "$ZAPRET_INIT" start >/dev/null 2>&1 || true
}
# include_vpn=1: VPN IPs stay IN nozapret (tunneled -> zapret leaves them alone)
# include_vpn=0: VPN IPs leave nozapret -> zapret DPI-bypasses them on WAN
rebuild_nozapret() {
    [ "$ZAPRET_ENABLED" = "1" ] || return 0
    zapret_available || return 0
    [ -x /usr/local/sbin/splify-sync-nozapret ] || return 1
    NOZAPRET_INCLUDE_VPN="$1" /usr/local/sbin/splify-sync-nozapret >/dev/null 2>&1
}

# ---- ipsum set self-heal (live set drained by a fw4 reload) -----------------
# This runs on EVERY tick, which is why it must not count the set. It used to:
# `nft list set` on the ipsum set (24k prefixes) expands every interval into text
# for ~50MB of RSS — every 180s, forever, on a router with ~96MB free. Instead
# probe two members from the source list (see set_healthy): a drained set fails
# the first probe, a load interrupted part-way fails the last one, and a healthy
# set costs two O(1) kernel lookups.
ensure_ipsum() {
    [ "$IPSUM_ENABLED" = "1" ] || return 0
    [ -s "$IPSUM_FILE" ] || { warn "ipsum list missing: $IPSUM_FILE"; return 1; }
    set_healthy "$IPSUM_TABLE" "$IPSUM_SET" "$IPSUM_FILE" && return 0
    log "ipsum set drained or incomplete, reloading from $IPSUM_FILE"
    nft_load_set "$IPSUM_TABLE" "$IPSUM_SET" "$IPSUM_FILE"
    _ei_rc=$?
    [ "$_ei_rc" = 0 ] && return 0
    # rc=2 — the list does not fit in this router's memory. nft_load_set has
    # already said so (throttled) and splify-doctor reports it as an actionable
    # finding. Retrying every tick is what turned this into an OOM reboot LOOP on
    # a 58MB box, so treat it as a settled condition, not a transient failure.
    [ "$_ei_rc" = 2 ] && return 0
    warn "ipsum reload failed"; return 1
}

# ru set self-heal — only relevant in full mode, where RU_SET is defined and
# carries the direct exception; replay it if a fw4 reload drained the live set.
ensure_ru() {
    [ "$MODE" = "full" ] && [ "$RU_ENABLED" = "1" ] || return 0
    [ -s "$RU_FILE" ] || return 0
    # Terse list: does the set exist at all, without dumping 40k+ elements.
    nft -t list set "$RU_TABLE" "$RU_SET" >/dev/null 2>&1 || return 0
    set_healthy "$RU_TABLE" "$RU_SET" "$RU_FILE" && return 0
    log "ru set drained or incomplete, reloading from $RU_FILE"
    nft_load_set "$RU_TABLE" "$RU_SET" "$RU_FILE" || true
}

# ---- geoblock path: one list pinned to one interface ------------------------
# Maintained on every tick because the interface can come and go independently of
# the tunnel failover is using. Present -> its own table gets a default route;
# absent -> the route AND the rule are removed, so those domains fall through to
# the normal policy path instead of black-holing. Under killswitch the fall-through
# would be a leak, so there the table is blackholed instead of emptied.
ensure_geo_route() {
    [ "$GEOBLOCK_ENABLED" = "1" ] && [ -n "$GEOBLOCK_IFACE" ] || {
        ip -4 rule del fwmark "$GEO_MARK/$GEO_MASK" table "$GEO_TABLE" priority "$GEO_RULE_PRIO" 2>/dev/null || true
        ip -4 route flush table "$GEO_TABLE" 2>/dev/null || true
        return 0
    }
    ensure_rule "$GEO_RULE_PRIO" "fwmark $GEO_MARK/$GEO_MASK lookup $GEO_TABLE" \
        ip -4 rule add fwmark "$GEO_MARK/$GEO_MASK" table "$GEO_TABLE" priority "$GEO_RULE_PRIO"
    if ep_present "$GEOBLOCK_IFACE"; then
        _geo_src="$(iface_src_ip "$GEOBLOCK_IFACE")"
        ip -4 route replace default dev "$GEOBLOCK_IFACE" ${_geo_src:+src "$_geo_src"} table "$GEO_TABLE" 2>/dev/null \
            || ip -4 route replace default dev "$GEOBLOCK_IFACE" table "$GEO_TABLE" 2>/dev/null || true
    elif [ "$KILLSWITCH" = "1" ]; then
        ip -4 route replace blackhole default table "$GEO_TABLE" 2>/dev/null || true
    else
        warn_throttled "geo-iface.$GEOBLOCK_IFACE" 3600 \
            "geoblock interface '$GEOBLOCK_IFACE' is not up — those domains follow the normal path until it returns"
        ip -4 route flush table "$GEO_TABLE" 2>/dev/null || true
    fi
}

# ---- routing ----------------------------------------------------------------
common_rules() {
    ensure_rule "$ANTI_LOOP_PRIO" "fwmark $ANTI_LOOP_MARK/$ANTI_LOOP_MASK lookup main" \
        ip -4 rule add fwmark "$ANTI_LOOP_MARK/$ANTI_LOOP_MASK" table main priority "$ANTI_LOOP_PRIO"
    ensure_rule "$WG_RULE_PRIO" "fwmark $WG_MARK/$WG_MARK_MASK lookup $WG_TABLE" \
        ip -4 rule add fwmark "$WG_MARK/$WG_MARK_MASK" table "$WG_TABLE" priority "$WG_RULE_PRIO"
}

clear_doh() {
    for _if in $(endpoints_by_priority); do
        for _ip in $DOH_IPS; do ip -4 route del "$_ip" dev "$_if" >/dev/null 2>&1 || true; done
    done
}

set_vpn() {   # $1 = healthy iface to carry policy-VPN traffic
    _if="$1"; _src="$(iface_src_ip "$_if")"
    common_rules
    ip -4 route replace default dev "$_if" table "$WG_TABLE"
    for _ip in $DOH_IPS; do pin_route "$_ip" "$_if" "$_src"; done
    ensure_ipsum
    ensure_ru
    # start zapret FIRST so its nozapret set exists before we sync it (the
    # table is "inet zapret" for zapret1 or "inet zapret2" for zapret2; both
    # are resolved in common.sh — a sync against a not-yet-created set fails
    # silently and leaves a stale set)
    ensure_zapret_running
    rebuild_nozapret 1
    write_state "vpn:$_if"; fail_reset
}

# Fail CLOSED: blackhole table 200 so marked policy traffic is dropped (not
# leaked to WAN) during the ifdown/handshake window of a restart/probe. Only used
# under killswitch; set_vpn lifts it by replacing the default route on recovery.
fail_closed() {
    common_rules
    ip -4 route replace blackhole default table "$WG_TABLE"
}

degrade() {   # no tunnel healthy
    if [ "$KILLSWITCH" = "1" ]; then
        common_rules
        ip -4 route replace blackhole default table "$WG_TABLE"
        clear_doh
        ensure_zapret_running
        write_state "killswitch"
        return
    fi
    ensure_rule "$ANTI_LOOP_PRIO" "fwmark $ANTI_LOOP_MARK/$ANTI_LOOP_MASK lookup main" \
        ip -4 rule add fwmark "$ANTI_LOOP_MARK/$ANTI_LOOP_MASK" table main priority "$ANTI_LOOP_PRIO"
    delete_rule_prio "$WG_RULE_PRIO"
    ip -4 route flush table "$WG_TABLE" >/dev/null 2>&1 || true
    clear_doh
    if [ "$ZAPRET_ENABLED" = "1" ] && zapret_available; then
        ensure_zapret_running
        # Only claim the zapret rung if the nozapret sync SUCCEEDED (else the VPN
        # prefixes stay exempt from bypass) AND nfqws is actually running — mere
        # availability (init/binary present) doesn't mean it came up.
        if rebuild_nozapret 0 && zapret_running && wan_healthy; then
            write_state "zapret"
        else
            write_state "wan"
        fi
    else
        write_state "wan"
    fi
}

# ---- one failover pass ------------------------------------------------------
tick() {
    # The geoblock interface is chosen by the operator and is independent of which
    # tunnel (if any) carries the main path, so its route is reconciled on every
    # tick rather than inside one of the path branches.
    ensure_geo_route

    _ordered="$(endpoints_by_priority)"
    [ -n "$_ordered" ] || { warn "no endpoints configured"; degrade; return; }

    _cur=""; case "$(read_state)" in vpn:*) _cur="$(active_iface)" ;; esac

    # Probe the active iface ONCE up front; the result feeds both the killswitch
    # decision and the loop below (probing it twice per tick doubled the
    # failure-detection latency by a full ping round).
    _cur_ok=""
    [ -n "$_cur" ] && iface_healthy "$_cur" && _cur_ok=1

    # killswitch: blackhole table 200 BEFORE any disruptive ifdown/probe whenever
    # we don't already have a healthy active tunnel — covers a stuck current iface
    # AND a cold start / previously-down state (_cur empty), so nothing leaks to
    # WAN during the probe window. set_vpn lifts it on recovery.
    if [ "$KILLSWITCH" = "1" ] && [ "$_cur_ok" != 1 ]; then
        fail_closed
    fi

    _best=""
    for _if in $_ordered; do
        if [ "$_if" = "$_cur" ]; then
            [ "$_cur_ok" = 1 ] && { _best="$_if"; break; }
            restart_iface "$_if"                       # stuck -> restart FIRST
            iface_healthy "$_if" && { _best="$_if"; break; }
        else
            probe_candidate "$_if" && { _best="$_if"; break; }
        fi
    done

    _prev="$(read_state)"
    if [ -n "$_best" ]; then
        set_vpn "$_best"
        if [ "$_prev" != "vpn:$_best" ]; then
            log "active tunnel -> $_best (mode $MODE)"
            # journal the transition (backs the LuCI timeline). Coming from another
            # tunnel is a `switch`; coming from a degraded path (wan/zapret/kill/cold)
            # is a `recover`.
            case "$_prev" in
                vpn:*) journal switch  "${_prev#vpn:}" "$_best" "failover" ;;
                *)     journal recover "${_prev:-none}" "$_best" "tunnel back up" ;;
            esac
        fi
    else
        _n=$(fail_inc)
        degrade
        _now="$(read_state)"
        if [ "$_prev" != "$_now" ]; then
            log "all tunnels down (fail #$_n) -> $_now"
            case "$_now" in
                killswitch) journal killswitch      "${_prev:-none}" killswitch "all tunnels down (fail #$_n)" ;;
                zapret)     journal zapret_fallback  "${_prev:-none}" zapret     "all tunnels down (fail #$_n)" ;;
                wan)        journal wan_fallback     "${_prev:-none}" wan        "all tunnels down (fail #$_n)" ;;
            esac
        fi
    fi
}

# ---- lost-list self-heal ------------------------------------------------------
# A list that was never downloaded (file missing) is fetched in the background
# instead of waiting for the daily cron. This must NOT run only at daemon start:
# at boot the WAN is often not up yet, that first fetch fails, and blocklist mode
# then routes nothing into the VPN until 04:30 — so retry on the daemon loop too,
# rate-limited by a tmpfs stamp. Only lists whose feature is enabled AND whose URL
# is configured count as "missing" (otherwise the retry would spin forever on a
# list that can never appear).
# WAIT_LOCK: a missing list must actually be fetched, not skipped behind a
# concurrent cron/apply run — wait out the holder rather than dropping it.
LIST_HEAL_STAMP="/var/run/splify-list-heal.stamp"
LIST_HEAL_EVERY=600
lists_missing() {
    [ "$IPSUM_ENABLED" = "1" ] && [ -n "$IPSUM_URL" ] && [ ! -s "$IPSUM_FILE" ] && return 0
    [ "$RU_ENABLED" = "1" ] && [ -n "$RU_URL" ] && [ ! -s "$RU_FILE" ] && return 0
    [ -n "$VPN_DOMAINS_URL" ] && [ ! -s "$DOMAINS_VPN_FILE" ] && return 0
    [ -n "$IGNORE_DOMAINS_URL" ] && [ ! -s "$DOMAINS_IGNORE_FILE" ] && return 0
    return 1
}
heal_lists() {
    lists_missing || return 0
    _now="$(date +%s)"; _last="$(cat "$LIST_HEAL_STAMP" 2>/dev/null)"
    case "$_last" in ''|*[!0-9]*) _last=0 ;; esac
    [ $((_now - _last)) -ge "$LIST_HEAL_EVERY" ] || return 0
    echo "$_now" > "$LIST_HEAL_STAMP" 2>/dev/null || true
    log "self-heal: fetching missing list(s) in background"
    ( export SPLIFY_WAIT_LOCK=1
      [ "$IPSUM_ENABLED" = "1" ] && [ -n "$IPSUM_URL" ] && [ ! -s "$IPSUM_FILE" ] \
          && /usr/local/sbin/splify-update-ipsum
      [ "$RU_ENABLED" = "1" ] && [ -n "$RU_URL" ] && [ ! -s "$RU_FILE" ] \
          && /usr/local/sbin/splify-update-ru
      if { [ -n "$VPN_DOMAINS_URL" ] && [ ! -s "$DOMAINS_VPN_FILE" ]; } \
         || { [ -n "$IGNORE_DOMAINS_URL" ] && [ ! -s "$DOMAINS_IGNORE_FILE" ]; }; then
          /usr/local/sbin/splify-update-domains
      fi
    ) >/dev/null 2>&1 &
}

# ---- pass mutex ---------------------------------------------------------------
# The daemon tick and a one-shot pass (splify-apply on Save&Apply / agent import /
# cron) otherwise interleave: both restart ifaces, write state and share the probe
# rule/table (prio 998 / table 201) — one pass can delete the other's probe rule
# mid-ping and manufacture a spurious "stuck endpoint" restart. Serialize whole
# passes; the subshell scopes the lock fd so it drops when the pass ends (a
# bare `flock 9` held by the long-lived daemon would starve one-shots forever).
# Degrades to unserialized if flock isn't installed. tick only communicates via
# files (state/journal/fail counter), so running it in a subshell changes nothing.
FAILOVER_LOCK="/var/run/splify-failover.lock"
run_pass() {
    # writability pre-check: if the lock file can't be opened the redirect would
    # kill the whole compound and the pass would silently never run.
    if command -v flock >/dev/null 2>&1 && : 2>/dev/null >> "$FAILOVER_LOCK"; then
        ( flock 9; tick ) 9>>"$FAILOVER_LOCK"
    else
        tick
    fi
}

# ---- entry ------------------------------------------------------------------
if [ "${1:-}" = "--daemon" ]; then
    [ -x /usr/local/sbin/splify-apply ] && /usr/local/sbin/splify-apply >/dev/null 2>&1 || true
    # first-run fetch happens immediately (drop a stale stamp from a prior daemon)
    rm -f "$LIST_HEAL_STAMP" 2>/dev/null || true
    heal_lists
    while :; do
        run_pass
        heal_lists
        _iv="$(uci -q get splify.global.interval 2>/dev/null)"
        [ "$_iv" -ge 5 ] 2>/dev/null || _iv=180
        sleep "$_iv"
    done
fi
run_pass
