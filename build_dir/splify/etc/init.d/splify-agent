#!/bin/sh /etc/rc.common
# procd service for the splify outbound control-plane agent. Started only when
# splify.api.agent_enabled=1; the daemon itself re-reads UCI each tick, so URL /
# interval / token changes take effect without a restart (toggling enabled does
# need restart — handled by splify-ctl api-set).
START=96
STOP=09
USE_PROCD=1

start_service() {
    . /lib/functions.sh
    config_load splify
    local enabled
    config_get enabled api agent_enabled 0
    [ "$enabled" = "1" ] || return 0

    procd_open_instance
    procd_set_param command /usr/local/sbin/splify-agent --daemon
    procd_set_param respawn 3600 10 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "splify"
}
