#!/bin/sh /etc/rc.common
# procd service for splify: regenerates the ruleset and runs the failover loop.
START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/local/sbin/splify-failover --daemon
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    ( /usr/local/sbin/splify-telemetry ) >/dev/null 2>&1 &
}

reload_service() {
    # The daemon sources UCI once at startup, so a config change (endpoints,
    # killswitch, health targets, mode, …) needs a restart to take effect — a
    # one-shot apply alone would leave the running daemon on the old options.
    # The daemon re-runs splify-apply on startup, so this also regenerates the
    # ruleset/routes.
    stop
    start
    # A changed list URL only takes effect on the next daily cron otherwise, so
    # refresh the lists now (background; the updaters validate + re-apply).
    # WAIT_LOCK: a changed URL must not be dropped if the daily cron is mid-run —
    # wait out the holder and apply the new UCI (cron itself stays skip-on-busy).
    # SKIP_UNCHANGED: refetch ONLY the lists whose URL actually changed. Without
    # it, every Save&Apply re-downloaded and re-aggregated all three; on a
    # single-core router that is minutes at 100% CPU, so toggling an unrelated
    # checkbox in the UI was enough to make a Mi 4C stop passing traffic. Cron
    # keeps refetching unconditionally, which is what picks up upstream edits.
    ( export SPLIFY_WAIT_LOCK=1 SPLIFY_SKIP_UNCHANGED=1
      /usr/local/sbin/splify-update-ipsum
      /usr/local/sbin/splify-update-ru
      /usr/local/sbin/splify-update-domains ) >/dev/null 2>&1 &
}

service_triggers() {
    procd_add_reload_trigger "splify"
}
