#!/bin/sh /etc/rc.common
# procd service for splify-dnsd — the native domain-routing backend (see
# common.sh's DOMAIN_BACKEND). Starts BEFORE the main splify service (which
# runs splify-apply on its own startup and, when this backend is active,
# installs an nft redirect rule pointing at this daemon's port) and stops
# AFTER it, so the redirect rule is never live without something listening
# behind it. Self-gates on the package actually being installed and on the
# operator not having forced the legacy 'dnsmasq' backend — same soft/
# runtime-detected-dependency convention as splify-singbox/zapret.
START=93
STOP=12
USE_PROCD=1

start_service() {
    . /lib/functions.sh
    # shellcheck source=/dev/null
    . /usr/local/lib/splify/common.sh

    splify_dns_available || { log "splify-dns: $SPLIFY_DNS_BIN not found — not starting"; return 0; }
    [ "$DOMAIN_BACKEND" = "native" ] || { log "splify-dns: dnsmasq backend forced (domain_backend) — not starting"; return 0; }

    # splify-apply (run on every apply, including the main service's own
    # startup) is the sole writer of the real rule contents — this just
    # guarantees the files exist so a first-ever start doesn't fail on ENOENT.
    mkdir -p "$SPLIFY_DNS_DIR"
    [ -f "$SPLIFY_DNS_VPN_RULES" ]    || : > "$SPLIFY_DNS_VPN_RULES"
    [ -f "$SPLIFY_DNS_DIRECT_RULES" ] || : > "$SPLIFY_DNS_DIRECT_RULES"
    [ -f "$SPLIFY_DNS_GEO_RULES" ]    || : > "$SPLIFY_DNS_GEO_RULES"

    procd_open_instance
    procd_set_param command "$SPLIFY_DNS_BIN" \
        --listen-port "$SPLIFY_DNS_PORT" --upstream-port 53 \
        --vpn-set "$VPN_SET" --direct-set "$DIRECT_SET" \
        --vpn-rules "$SPLIFY_DNS_VPN_RULES" --direct-rules "$SPLIFY_DNS_DIRECT_RULES" \
        --geo-set "$GEO_SET" --geo-rules "$SPLIFY_DNS_GEO_RULES" \
        --fakeip-state "$SPLIFY_DNS_FAKEIP_STATE" --fakeip-map "$SPLIFY_DNS_FAKEIP_MAP" \
        --table "inet fw4"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param reload_signal HUP
    procd_close_instance
}

reload_service() {
    procd_send_signal splify-dns
}

service_triggers() {
    procd_add_reload_trigger "splify"
}
